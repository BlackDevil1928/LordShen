{
  "web_frameworks": {
    "WordPress": {"headers": ["X-Powered-By: WP Engine", "X-Pingback"], "body": ["wp-content", "wp-includes", "wp-json"], "cookies": ["wordpress_"]},
    "Drupal": {"headers": ["X-Generator: Drupal"], "body": ["Drupal.settings", "drupal.js"], "cookies": ["SSESS", "Drupal.visitor"]},
    "Joomla": {"headers": [], "body": ["/media/jui/", "Joomla!"], "cookies": ["joomla_"]},
    "Django": {"headers": [], "body": ["csrfmiddlewaretoken", "__admin__"], "cookies": ["csrftoken", "sessionid"]},
    "Rails": {"headers": ["X-Powered-By: Phusion Passenger"], "body": ["csrf-token", "authenticity_token"], "cookies": ["_session_id"]},
    "Laravel": {"headers": [], "body": ["laravel_token"], "cookies": ["laravel_session", "XSRF-TOKEN"]},
    "Express": {"headers": ["X-Powered-By: Express"], "body": [], "cookies": ["connect.sid"]},
    "Spring": {"headers": [], "body": ["spring.io", "whitelabel"], "cookies": ["JSESSIONID"]},
    "ASP.NET": {"headers": ["X-AspNet-Version", "X-Powered-By: ASP.NET"], "body": ["__VIEWSTATE", "__EVENTVALIDATION"], "cookies": ["ASP.NET_SessionId", ".ASPXAUTH"]},
    "Flask": {"headers": [], "body": [], "cookies": ["session"]},
    "FastAPI": {"headers": [], "body": ["/openapi.json", "/docs", "/redoc"], "cookies": []},
    "Next.js": {"headers": ["X-Powered-By: Next.js"], "body": ["__NEXT_DATA__", "_next/static"], "cookies": []}
  },
  "web_servers": {
    "Nginx": {"headers": ["Server: nginx"], "body": ["nginx"]},
    "Apache": {"headers": ["Server: Apache"], "body": ["Apache"]},
    "IIS": {"headers": ["Server: Microsoft-IIS"], "body": ["Microsoft-IIS"]},
    "LiteSpeed": {"headers": ["Server: LiteSpeed"], "body": []},
    "Caddy": {"headers": ["Server: Caddy"], "body": []},
    "Tomcat": {"headers": ["Server: Apache-Coyote"], "body": ["Apache Tomcat"]}
  },
  "waf": {
    "Cloudflare": {"headers": ["cf-ray", "server: cloudflare"], "body": ["Attention Required! | Cloudflare"], "cookies": ["__cfduid", "cf_clearance"]},
    "AWS WAF": {"headers": ["x-amzn-requestid"], "body": ["aws waf"], "cookies": []},
    "Akamai": {"headers": ["X-Akamai-Transformed", "Server: AkamaiGHost"], "body": ["Access Denied - Akamai"], "cookies": ["akamai"]},
    "Imperva": {"headers": ["X-CDN: Imperva"], "body": ["Incapsula"], "cookies": ["incap_ses", "visid_incap"]},
    "Sucuri": {"headers": ["X-Sucuri-ID"], "body": ["Sucuri Website Firewall"], "cookies": []},
    "F5 BIG-IP": {"headers": ["Server: BigIP", "X-WA-Info"], "body": ["BIG-IP"], "cookies": ["BIGipServer"]}
  },
  "databases": {
    "MySQL": {"error_patterns": ["mysql_", "mysqli_", "SQL syntax.*MySQL", "MySqlException"]},
    "PostgreSQL": {"error_patterns": ["pg_", "PG::Error", "PostgreSQL.*ERROR", "PSQLException"]},
    "MSSQL": {"error_patterns": ["mssql_", "SqlException", "ODBC SQL Server Driver", "SQLServer"]},
    "Oracle": {"error_patterns": ["ORA-", "oracle.jdbc", "OracleException"]},
    "MongoDB": {"error_patterns": ["MongoError", "mongo.*error", "MongoDB"]},
    "SQLite": {"error_patterns": ["sqlite_", "SQLiteException", "SQLITE_ERROR"]}
  }
}
