# ──────────────────────────────────────────────
#  AutoPentest AI — .gitignore
# ──────────────────────────────────────────────

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-wheel-metadata/
*.manifest
*.spec

# ─── Virtual Environments ───
.venv/
venv/
ENV/
env/

# ─── IDE / Editor ───
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ─── AutoPentest Runtime Data ───
# Config & database (user-specific, created at runtime)
.autopentest/

# Scan output temp files
autopentest_*.json
autopentest_*.xml
autopentest_*.txt

# ─── Reports (generated, not source) ───
*.pdf
!assets/*.pdf

# ─── Secrets & Keys ───
.env
.env.*
*.pem
*.key
config.json

# ─── ML Models (trained locally) ───
*.pkl
*.joblib

# ─── Cache ───
.cache/
*.cache
diskcache/

# ─── Logs ───
*.log

# ─── Testing ───
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ─── Misc ───
*.bak
*.tmp
*.temp
.gemini/
